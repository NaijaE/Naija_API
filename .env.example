NODE_ENV=development
PORT=4000

# MongoDB Atlas (a replica set is REQUIRED: money operations use transactions)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/naijaearn?retryWrites=true&w=majority

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Frontend origins allowed by CORS (comma separated, no trailing slash)
CLIENT_ORIGINS=http://localhost:5173
# Where Paystack/Flutterwave send the buyer back; the API appends ?order=<id>
PAYMENT_RETURN_URL=http://localhost:5173/#/app/advertise

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYSTACK_SECRET_KEY=sk_test_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
# The "secret hash" you set in the Flutterwave dashboard webhook settings
FLUTTERWAVE_SECRET_HASH=

# Email (nodemailer SMTP). Without these, codes are only logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Naija Earn <no-reply@example.com>"

# SMS via Termii (optional)
TERMII_API_KEY=
TERMII_SENDER_ID=NaijaEarn

# Development only: include verification/reset codes in API responses
EXPOSE_DEV_CODES=true

# Bank account shown to advertisers who pay by manual transfer
BANK_NAME=Demo Bank
BANK_ACCOUNT_NAME=Naija Earn Ltd
BANK_ACCOUNT_NUMBER=0000000000
